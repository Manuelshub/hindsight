# --- wallet ---
# Use a throwaway key. Never commit the real .env.
PRIVATE_KEY=

# --- 0G networks ---
# Compute + fine-tuning stay on testnet (allowed by the buildathon rules).
OG_TESTNET_RPC=https://evmrpc-testnet.0g.ai
OG_TESTNET_CHAIN_ID=16602
OG_TESTNET_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Lineage registry is deployed to mainnet (required from Wave 3 onward).
OG_MAINNET_RPC=https://evmrpc.0g.ai
OG_MAINNET_CHAIN_ID=16661
OG_MAINNET_INDEXER=https://indexer-storage-turbo.0g.ai

# --- deployed contracts (filled in after deploy) ---
LINEAGE_REGISTRY_ADDRESS=

# --- compute ---
# Populated from `0g-compute-cli fine-tuning list-providers`
FINE_TUNING_PROVIDER=
# Populated from `broker.inference.listService()`
INFERENCE_PROVIDER=
